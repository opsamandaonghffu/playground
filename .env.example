# 复制这里的内容到 Infrlo 控制台的 Environment Variables
# 不要把这个文件里的真实密码提交到公开仓库；本文件只是模板

NODE_ENV=production
SILLYTAVERN_BASICAUTHUSER_USERNAME=换成你自己的用户名
SILLYTAVERN_BASICAUTHUSER_PASSWORD=换成一个足够强的随机密码

# 可选：进一步压内存（默认 100mb）
SILLYTAVERN_PERFORMANCE_MEMORYCACHECAPACITY=32mb

# 仅当日志显示实际监听端口与平台外部端口不一致时才手动加，值 = 平台注入的 PORT
# SILLYTAVERN_PORT=5000

# 下面三项已经写进 Dockerfile，不用重复填：
# SILLYTAVERN_LISTEN=true
# SILLYTAVERN_WHITELISTMODE=false
# SILLYTAVERN_BASICAUTHMODE=true
